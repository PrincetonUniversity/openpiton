                      print("  .ready_in(tile_%d_%d_valrdy_horz_far_noc%d_ready));" % (j,i,k))
                      always_eth_retry_tx += '''
                        if (tile_%d_%d_valrdy_horz_far_eth%d_valid & tile_%d_%d_valrdy_horz_far_eth%d_last) begin
                          if ( ethack_wait_time                   <                                  tile_%d_%d_horz_ack%d_wait_time)  ethack_wait_time <= tile_%d_%d_horz_ack%d_wait_time;
                          if (!ethack_wait_time || (ethfr_retries < tile_%d_%d_horz_eth%d_retries && tile_%d_%d_horz_ack%d_wait_time)) ethfr_retries    <= tile_%d_%d_horz_eth%d_retries;
                        end
                      ''' % (j,i,k, j,i,k, j,i,k, j,i,k, j,i,k, j,i,k, j,i,k)

                    # Horizontal Rx partitioning
                    if (PITON_TO_X != PITON_X_TILES-1) and (i == PITON_TO_X):
                      currenttile = currenttile.replace("in_E_", "tile_%d_%d_inE_" % (j,i));
                      print("wire [`DATA_WIDTH-1:0] tile_%d_%d_valrdy_horz_near_E_noc%d_data;"  % (j,i,k))
                      print("wire                   tile_%d_%d_valrdy_horz_near_E_noc%d_valid;" % (j,i,k))
                      print("wire                   tile_%d_%d_valrdy_horz_near_E_noc%d_ready;" % (j,i,k))
                      print("wire [`DATA_WIDTH-1:0] tile_%d_%d_inE_noc%d_data;"  % (j,i,k))
                      print("wire                   tile_%d_%d_inE_noc%d_valid;" % (j,i,k))
                      print("valrdy_to_credit tile_%d_%d_E_noc%d_v2c(.clk(clk_muxed), .reset(~rstn_tile)," % (j,i,k))
                      print("  .data_in  (tile_%d_%d_valrdy_horz_near_E_noc%d_data ), " % (j,i,k))
                      print("  .valid_in (tile_%d_%d_valrdy_horz_near_E_noc%d_valid), " % (j,i,k))
                      print("  .ready_in (tile_%d_%d_valrdy_horz_near_E_noc%d_ready), " % (j,i,k))
                      print("  .data_out (tile_%d_%d_inE_noc%d_data        ), " % (j,i,k))
                      print("  .valid_out(tile_%d_%d_inE_noc%d_valid       ), " % (j,i,k))
                      print("  .yummy_out(tile_%d_%d_out_E_noc%d_yummy     ));" % (j,i,k))
                      # Horizontal Rx partitioning through CMAC
                      if (PITON_TOX_PORT == 0):
                        print("wire [`DATA_WIDTH-1:0] tile_%d_%d_valrdy_horz_near_E_eth%d_data;"  % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_E_eth%d_valid;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_E_eth%d_ready;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_E_eth%d_last;"  % (j,i,k))
                        print("wire [CMAC_USE_DAT_BYTES*8-1:0] tile_%d_%d_valrdy_horz_near_E_ack%d_data;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_E_ack%d_valid;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_E_ack%d_ready;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_E_ack%d_last;"  % (j,i,k))
                        print("wire [ETHHDR_NOC_WIDTH-1:0] tile_%d_%d_horz_E_noc%d_eth_hdr_rx;"   % (j,i,k))
                        print("ethframe_to_valrdy tile_%d_%d_E_noc%d_ethextr(.clk(clk_muxed), .rst(~rstn_tile), .dst_src_mac_tx(dst_src_mac_to)," % (j,i,k))
                        print("  .data_in  (tile_%d_%d_valrdy_horz_near_E_eth%d_data ), " % (j,i,k))
                        print("  .valid_in (tile_%d_%d_valrdy_horz_near_E_eth%d_valid), " % (j,i,k))
                        print("  .ready_in (tile_%d_%d_valrdy_horz_near_E_eth%d_ready), " % (j,i,k))
                        print("  .last_in  (tile_%d_%d_valrdy_horz_near_E_eth%d_last),  " % (j,i,k))
                        print("  .data_ack (tile_%d_%d_valrdy_horz_near_E_ack%d_data ), " % (j,i,k))
                        print("  .valid_ack(tile_%d_%d_valrdy_horz_near_E_ack%d_valid), " % (j,i,k))
                        print("  .ready_ack(tile_%d_%d_valrdy_horz_near_E_ack%d_ready), " % (j,i,k))
                        print("  .last_ack (tile_%d_%d_valrdy_horz_near_E_ack%d_last),  " % (j,i,k))
                        print("  .flit_out (tile_%d_%d_valrdy_horz_near_E_noc%d_data ), " % (j,i,k))
                        print("  .valid_out(tile_%d_%d_valrdy_horz_near_E_noc%d_valid), " % (j,i,k))
                        print("  .ready_out(tile_%d_%d_valrdy_horz_near_E_noc%d_ready), " % (j,i,k))
                        print("  .eth_hdr_out(tile_%d_%d_horz_E_noc%d_eth_hdr_rx     ));" % (j,i,k))
                        always_eth_hdr_rx += '''
                          if (tile_%d_%d_valrdy_horz_near_E_eth%d_valid & tile_%d_%d_valrdy_horz_near_E_eth%d_last) eth_hdr_rx <= tile_%d_%d_horz_E_noc%d_eth_hdr_rx;
                        ''' % (j,i,k, j,i,k, j,i,k)

                    # Horizontal Rx partitioning
                    if (PITON_FR_X != 0) and (i == PITON_FR_X):
                      currenttile = currenttile.replace("in_W_", "tile_%d_%d_inW_" % (j,i));
                      print("wire [`DATA_WIDTH-1:0] tile_%d_%d_valrdy_horz_near_W_noc%d_data;"  % (j,i,k))
                      print("wire                   tile_%d_%d_valrdy_horz_near_W_noc%d_valid;" % (j,i,k))
                      print("wire                   tile_%d_%d_valrdy_horz_near_W_noc%d_ready;" % (j,i,k))
                      print("wire [`DATA_WIDTH-1:0] tile_%d_%d_inW_noc%d_data;"  % (j,i,k))
                      print("wire                   tile_%d_%d_inW_noc%d_valid;" % (j,i,k))
                      print("valrdy_to_credit tile_%d_%d_W_noc%d_v2c(.clk(clk_muxed), .reset(~rstn_tile)," % (j,i,k))
                      print("  .data_in  (tile_%d_%d_valrdy_horz_near_W_noc%d_data ), " % (j,i,k))
                      print("  .valid_in (tile_%d_%d_valrdy_horz_near_W_noc%d_valid), " % (j,i,k))
                      print("  .ready_in (tile_%d_%d_valrdy_horz_near_W_noc%d_ready), " % (j,i,k))
                      print("  .data_out (tile_%d_%d_inW_noc%d_data        ), " % (j,i,k))
                      print("  .valid_out(tile_%d_%d_inW_noc%d_valid       ), " % (j,i,k))
                      print("  .yummy_out(tile_%d_%d_out_W_noc%d_yummy     ));" % (j,i,k))
                      # Horizontal Rx partitioning through CMAC
                      if (PITON_FRX_PORT == 0):
                        print("wire [`DATA_WIDTH-1:0] tile_%d_%d_valrdy_horz_near_W_eth%d_data;"  % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_W_eth%d_valid;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_W_eth%d_ready;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_W_eth%d_last;"  % (j,i,k))
                        print("wire [CMAC_USE_DAT_BYTES*8-1:0] tile_%d_%d_valrdy_horz_near_W_ack%d_data;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_W_ack%d_valid;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_W_ack%d_ready;" % (j,i,k))
                        print("wire                   tile_%d_%d_valrdy_horz_near_W_ack%d_last;"  % (j,i,k))
                        print("wire [ETHHDR_NOC_WIDTH-1:0] tile_%d_%d_horz_W_noc%d_eth_hdr_rx;"   % (j,i,k))
                        print("ethframe_to_valrdy tile_%d_%d_W_noc%d_ethextr(.clk(clk_muxed), .rst(~rstn_tile), .dst_src_mac_tx(dst_src_mac_fr)," % (j,i,k))
                        print("  .data_in  (tile_%d_%d_valrdy_horz_near_W_eth%d_data ), " % (j,i,k))
                        print("  .valid_in (tile_%d_%d_valrdy_horz_near_W_eth%d_valid), " % (j,i,k))
                        print("  .ready_in (tile_%d_%d_valrdy_horz_near_W_eth%d_ready), " % (j,i,k))
                        print("  .last_in  (tile_%d_%d_valrdy_horz_near_W_eth%d_last),  " % (j,i,k))
                        print("  .data_ack (tile_%d_%d_valrdy_horz_near_W_ack%d_data ), " % (j,i,k))
                        print("  .valid_ack(tile_%d_%d_valrdy_horz_near_W_ack%d_valid), " % (j,i,k))
                        print("  .ready_ack(tile_%d_%d_valrdy_horz_near_W_ack%d_ready), " % (j,i,k))
                        print("  .last_ack (tile_%d_%d_valrdy_horz_near_W_ack%d_last),  " % (j,i,k))
                        print("  .flit_out (tile_%d_%d_valrdy_horz_near_W_noc%d_data ), " % (j,i,k))
                        print("  .valid_out(tile_%d_%d_valrdy_horz_near_W_noc%d_valid), " % (j,i,k))
                        print("  .ready_out(tile_%d_%d_valrdy_horz_near_W_noc%d_ready), " % (j,i,k))
                        print("  .eth_hdr_out(tile_%d_%d_horz_W_noc%d_eth_hdr_rx     ));" % (j,i,k))
                        always_eth_hdr_rx += '''
                          if (tile_%d_%d_valrdy_horz_near_W_eth%d_valid & tile_%d_%d_valrdy_horz_near_W_eth%d_last) eth_hdr_rx <= tile_%d_%d_horz_W_noc%d_eth_hdr_rx;
                        ''' % (j,i,k, j,i,k, j,i,k)


                currenttile = currenttile.replace("in_N", idN + "_out_S");
                currenttile = currenttile.replace("in_S", idS + "_out_N");
                currenttile = currenttile.replace("in_E", idE + "_out_W");
                currenttile = currenttile.replace("in_W", idW + "_out_E");

            # print "`ifdef RTL_SPARC%d" % flatid
            if   (PITON_FR_X <= i and i <= PITON_TO_X) or (PITON_FR_X > PITON_TO_X):
              if (PITON_FR_Y <= j and j <= PITON_TO_Y) or (PITON_FR_Y > PITON_TO_Y):
                print(currenttile)
            # print "`endif"
    print ("`ifdef PITON_PRONOC");
    print(assign + edge_assign)
    print("`endif")    

    print(always_eth_hdr_rx)
    print("    end")
    print(always_eth_retry_tx)
    print("    end")
%>


`ifdef PITON_MULTI_FPGA
    wire ctrl_rx_aur;
    wire ctrl_rx_cmac;
    wire [2:0] loopback_aur;
    wire [2:0] loopback_cmac;
    wire [`PITON_NUM_TILES*4-1:0] free_ctrl_tx = ((ctrl_rx_aur  && !loopback_aur) ||
                                                  (ctrl_rx_cmac && !loopback_cmac)) ? {irq_tile, timer_irq_tile, ipi_tile} :
                                                                                      {irq_i, timer_irq_i, ipi_i};
    reg  [`PITON_NUM_TILES*4-1:0] free_ctrl_tx_reg;
    reg                           free_ctrl_tx_val_aur;
    reg                           free_ctrl_tx_val_cmac;
    wire                          free_ctrl_tx_rdy_aur;
    wire                          free_ctrl_tx_rdy_cmac;
    always @(posedge clk_muxed)
      if (~rstn_tile) begin
        free_ctrl_tx_val_aur  <= 1'b0;
        free_ctrl_tx_val_cmac <= 1'b0;
      end else begin
        free_ctrl_tx_reg <= free_ctrl_tx;
        if (free_ctrl_tx != free_ctrl_tx_reg) begin
          free_ctrl_tx_val_aur  <= 1'b1;
          free_ctrl_tx_val_cmac <= 1'b1;
        end else begin 
          if (free_ctrl_tx_rdy_aur)  free_ctrl_tx_val_aur  <= 1'b0;
          if (free_ctrl_tx_rdy_cmac) free_ctrl_tx_val_cmac <= 1'b0;
        end
      end

    wire [`PITON_NUM_TILES*4-1:0] free_ctrl_rx_aur;
    wire [`PITON_NUM_TILES*4-1:0] free_ctrl_rx_cmac;
    reg  [`PITON_NUM_TILES*4-1:0] free_ctrl_rx_reg;
    wire                          free_ctrl_rx_val_aur;
    wire                          free_ctrl_rx_val_cmac;
    always @(posedge clk_muxed)
      if (~rstn_tile)              free_ctrl_rx_reg <= 0;
      else begin 
        if (free_ctrl_rx_val_aur)  free_ctrl_rx_reg <= free_ctrl_rx_aur;
        if (free_ctrl_rx_val_cmac) free_ctrl_rx_reg <= free_ctrl_rx_cmac;
    end

    assign {irq_tile, timer_irq_tile, ipi_tile} = (ctrl_rx_aur || ctrl_rx_cmac) ? free_ctrl_rx_reg : {irq_i, timer_irq_i, ipi_i};

    wire sys_rstn_aur;
    wire sys_rstn_cmac;
    assign rstn_tile = rst_n_inter_sync; // & sys_rstn_aur & sys_rstn_cmac;

   `ifdef PITON_MULTI_FPGA_AUR
     wire aur_clk;
     wire aur_rstn;
     wire aur_rx_overflow;
     reg [2:0] aur_overflow_sync;
     always @(posedge aur_clk)
       if (~aur_rstn)            aur_overflow_sync[0] <= 1'b0;
       else if (aur_rx_overflow) aur_overflow_sync[0] <= 1'b1;

     always @(posedge clk_muxed)
       if (~rstn_tile) aur_overflow_sync[2:1] <= 2'b0;
       else            aur_overflow_sync[2:1] <= {aur_overflow_sync[1:0]};
     assign qsfp_noc_overflow = aur_overflow_sync[2];

     wire ctrl_tx_aur;
     axistx_aurora_bridge  nocs_aur_bridge  (.sys_clk(clk_muxed), .sys_rstn(rst_n_inter_sync),
                                             .sys_rstn_out(sys_rstn_aur), .sys_rstn_in(rstn_tile),
                                             .qsfp_clk(aur_clk), .qsfp_rstn(aur_rstn),
                                             .rx_overflow(aur_rx_overflow),

                                             .s_axis_0_tdata (free_ctrl_tx_reg),
                                             .s_axis_0_tvalid(free_ctrl_tx_val_aur & ctrl_tx_aur),
                                             .s_axis_0_tready(free_ctrl_tx_rdy_aur),
                                             .s_axis_0_tlast (1'b1),
                                             .m_axis_0_tdata (free_ctrl_rx_aur),
                                             .m_axis_0_tvalid(free_ctrl_rx_val_aur),
                                             .m_axis_0_tready(1'b1),

                                             .qsfp_rx_4x_rxn   (aur_qsfp_4x_grx_n),
                                             .qsfp_rx_4x_rxp   (aur_qsfp_4x_grx_p),
                                             .qsfp_tx_4x_txn   (aur_qsfp_4x_gtx_n),
                                             .qsfp_tx_4x_txp   (aur_qsfp_4x_gtx_p),
                                             .qsfp_refck_clk_n (aur_qsfp_ref_clk_n),
                                             .qsfp_refck_clk_p (aur_qsfp_ref_clk_p),
<%
    ctrl_tx = 0
    ctrl_rx = 0
    chanid = 1
    loopback_mode = 0

    if (((PITON_FR_Y > PITON_TO_Y) and (PITON_FRY_PORT == 1) and (PITON_TOY_PORT == 1)) or
        ((PITON_FR_X > PITON_TO_X) and (PITON_FRX_PORT == 1) and (PITON_TOX_PORT == 1))):
      loopback_mode = 2

    for k in [1,2,3]:

      # Vertical partitioning through Aurora
      for i in range(PITON_X_TILES):
        if (PITON_FR_Y != 0) and (PITON_FRY_PORT == 1):
          ctrl_rx = 1
          if (loopback_mode == 0): y_far = PITON_FR_Y-1
          else:                    y_far = PITON_FR_Y
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_vert_near_N_noc%d_data), " % (chanid,PITON_FR_Y,i,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_vert_near_N_noc%d_valid)," % (chanid,PITON_FR_Y,i,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_vert_near_N_noc%d_ready)," % (chanid,PITON_FR_Y,i,k))
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_vert_far_noc%d_data),    " % (chanid,y_far,i,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_vert_far_noc%d_valid),   " % (chanid,y_far,i,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_vert_far_noc%d_ready),   " % (chanid,y_far,i,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_vert_far_noc%d_last),    " % (chanid,y_far,i,k))
          chanid = chanid + 1
        if (PITON_TO_Y != PITON_Y_TILES-1) and (PITON_TOY_PORT == 1):
          ctrl_tx = 1
          if (loopback_mode == 0): y_far = PITON_TO_Y+1
          else:                    y_far = PITON_TO_Y
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_vert_near_S_noc%d_data), " % (chanid,PITON_TO_Y,i,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_vert_near_S_noc%d_valid)," % (chanid,PITON_TO_Y,i,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_vert_near_S_noc%d_ready)," % (chanid,PITON_TO_Y,i,k))
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_vert_far_noc%d_data),    " % (chanid,y_far,i,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_vert_far_noc%d_valid),   " % (chanid,y_far,i,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_vert_far_noc%d_ready),   " % (chanid,y_far,i,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_vert_far_noc%d_last),    " % (chanid,y_far,i,k))
          chanid = chanid + 1

      # Horizontal partitioning through Aurora
      for j in range(PITON_Y_TILES):
        if (PITON_FR_X != 0) and (PITON_FRX_PORT == 1):
          ctrl_rx = 1
          if (loopback_mode == 0): x_far = PITON_FR_X-1
          else:                    x_far = PITON_FR_X
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_horz_near_W_noc%d_data), " % (chanid,j,PITON_FR_X,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_horz_near_W_noc%d_valid)," % (chanid,j,PITON_FR_X,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_horz_near_W_noc%d_ready)," % (chanid,j,PITON_FR_X,k))
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_horz_far_noc%d_data),    " % (chanid,j,x_far,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_horz_far_noc%d_valid),   " % (chanid,j,x_far,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_horz_far_noc%d_ready),   " % (chanid,j,x_far,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_horz_far_noc%d_last) ,   " % (chanid,j,x_far,k))
          chanid = chanid + 1
        if (PITON_TO_X != PITON_X_TILES-1) and (PITON_TOX_PORT == 1):
          ctrl_tx = 1
          if (loopback_mode == 0): x_far = PITON_TO_X+1
          else:                    x_far = PITON_TO_X
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_horz_near_E_noc%d_data), " % (chanid,j,PITON_TO_X,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_horz_near_E_noc%d_valid)," % (chanid,j,PITON_TO_X,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_horz_near_E_noc%d_ready)," % (chanid,j,PITON_TO_X,k))
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_horz_far_noc%d_data),    " % (chanid,j,x_far,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_horz_far_noc%d_valid),   " % (chanid,j,x_far,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_horz_far_noc%d_ready),   " % (chanid,j,x_far,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_horz_far_noc%d_last) ,   " % (chanid,j,x_far,k))
          chanid = chanid + 1

    print("      .loopback_mode(loopback_aur));")
    print("assign loopback_aur = 3'h%x;" % (loopback_mode))
    print("assign ctrl_tx_aur = 1'b%d;" % (ctrl_tx))
    print("assign ctrl_rx_aur = 1'b%d;" % (ctrl_rx))
%>
   `else                                             
     assign sys_rstn_aur      = 1;
     assign loopback_aur      = 0;
     assign qsfp_noc_overflow = 0;
   `endif // `ifdef PITON_MULTI_FPGA_AUR


   `ifdef PITON_MULTI_FPGA_CMAC
     wire [`PITON_NUM_TILES*4  -1:0] freectrl_tx_eth_data;
     wire                            freectrl_tx_eth_valid;
     wire                            freectrl_tx_eth_ready;
     wire                            freectrl_tx_eth_last;
     wire [CMAC_USE_DAT_BYTES*8-1:0] freectrl_tx_ack_data;
     wire                            freectrl_tx_ack_valid;
     wire                            freectrl_tx_ack_ready;
     wire                            freectrl_tx_ack_last;
     wire ctrl_tx_cmac;
     valrdy_to_ethframe #(.SINGLE_INFLIT(1),
                          .DAT_WIDTH(`PITON_NUM_TILES*4)
                         )
                        freectrl_ethgen (.clk(clk_muxed), .rst(~rstn_tile), .dst_src_mac_tx(dst_src_mac_to),
                                         .flit_in (free_ctrl_tx_reg),
                                         .valid_in(free_ctrl_tx_val_cmac & ctrl_tx_cmac),
                                         .ready_in(free_ctrl_tx_rdy_cmac),
                                         .data_out (freectrl_tx_eth_data),
                                         .valid_out(freectrl_tx_eth_valid),
                                         .ready_out(freectrl_tx_eth_ready),
                                         .last_out (freectrl_tx_eth_last),
                                         .data_ack (freectrl_tx_ack_data),
                                         .valid_ack(freectrl_tx_ack_valid),
                                         .ready_ack(freectrl_tx_ack_ready),
                                         .last_ack (freectrl_tx_ack_last));

     wire [`PITON_NUM_TILES*4  -1:0] freectrl_rx_eth_data;
     wire                            freectrl_rx_eth_valid;
     wire                            freectrl_rx_eth_ready;
     wire                            freectrl_rx_eth_last;
     wire [CMAC_USE_DAT_BYTES*8-1:0] freectrl_rx_ack_data;
     wire                            freectrl_rx_ack_valid;
     wire                            freectrl_rx_ack_ready;
     wire                            freectrl_rx_ack_last;
     ethframe_to_valrdy #(.DAT_WIDTH(`PITON_NUM_TILES*4)
                         )
                        freectrl_ethextr (.clk(clk_muxed), .rst(~rstn_tile), .dst_src_mac_tx(dst_src_mac_fr),
                                          .data_in (freectrl_rx_eth_data),
                                          .valid_in(freectrl_rx_eth_valid),
                                          .ready_in(freectrl_rx_eth_ready),
                                          .last_in (freectrl_rx_eth_last),
                                          .flit_out (free_ctrl_rx_cmac),
                                          .valid_out(free_ctrl_rx_val_cmac),
                                          .ready_out(1'b1),
                                          .data_ack (freectrl_rx_ack_data),
                                          .valid_ack(freectrl_rx_ack_valid),
                                          .ready_ack(freectrl_rx_ack_ready),
                                          .last_ack (freectrl_rx_ack_last));

     wire cmac_clk;
     wire cmac_rstn;
     wire [CMAC_FULL_DAT_BYTES*8-1 :0] ethcmac_data;
     wire [CMAC_FULL_DAT_BYTES  -1 :0] ethcmac_keep;
     wire                              ethcmac_badpack;
     wire                              ethcmac_last;
     wire                              ethcmac_valid;
     wire [CMAC_USE_DAT_BYTES*8 -1 :0] nocsdemux_data;
     wire [CMAC_USE_DAT_BYTES   -1 :0] nocsdemux_keep;
     wire [AXIS_TDEST_BYTES  *8 -1 :0] nocsdemux_dest;
     wire                              nocsdemux_last;
     wire                              nocsdemux_ready;
     wire                              nocsdemux_valid;
     ethcmac_to_demux ethcmac_to_demux_inst(.clk(cmac_clk), .rst(~cmac_rstn),
       .data_in   (ethcmac_data),
       .keep_in   (ethcmac_keep),
       .badpack_in(ethcmac_badpack),
       .last_in   (ethcmac_last),
       .valid_in (ethcmac_valid),
       .data_out (nocsdemux_data),
       .keep_out (nocsdemux_keep),
       .dest_out (nocsdemux_dest),
       .last_out (nocsdemux_last),
       .ready_out(nocsdemux_ready),
       .valid_out(nocsdemux_valid)
     );

     axistx_cmac_bridge  nocs_cmac_bridge (.sys_clk(clk_muxed), .sys_rstn(rst_n_inter_sync),
                                           .sys_rstn_out(sys_rstn_cmac), .sys_rstn_in(rstn_tile),
                                           .qsfp_clk(cmac_clk), .qsfp_rstn(cmac_rstn),

                                           .s_axis_0_tdata (freectrl_tx_eth_data),
                                           .s_axis_0_tvalid(freectrl_tx_eth_valid),
                                           .s_axis_0_tready(freectrl_tx_eth_ready),
                                           .s_axis_0_tlast (freectrl_tx_eth_last),
                                           .chan_tdest_0 (0),
                                           .m_axis_0_tdata (freectrl_rx_eth_data),
                                           .m_axis_0_tvalid(freectrl_rx_eth_valid),
                                           .m_axis_0_tready(freectrl_rx_eth_ready),
                                           .m_axis_0_tlast (freectrl_rx_eth_last),
                                           .s_axis_1_tdata (freectrl_rx_ack_data),
                                           .s_axis_1_tvalid(freectrl_rx_ack_valid),
                                           .s_axis_1_tready(freectrl_rx_ack_ready),
                                           .s_axis_1_tlast (freectrl_rx_ack_last),
                                           .chan_tdest_1 (1),
                                           .m_axis_1_tdata (freectrl_tx_ack_data),
                                           .m_axis_1_tvalid(freectrl_tx_ack_valid),
                                           .m_axis_1_tready(freectrl_tx_ack_ready),
                                           .m_axis_1_tlast (freectrl_tx_ack_last),

                                           .m_axis_cmac_rx_tdata (ethcmac_data),
                                           .m_axis_cmac_rx_tkeep (ethcmac_keep),
                                           .m_axis_cmac_rx_tuser (ethcmac_badpack),
                                           .m_axis_cmac_rx_tlast (ethcmac_last),
                                           .m_axis_cmac_rx_tvalid(ethcmac_valid),
                                           .s_axis_demux_rx_tdata (nocsdemux_data),
                                           .s_axis_demux_rx_tkeep (nocsdemux_keep),
                                           .s_axis_demux_rx_tdest (nocsdemux_dest),
                                           .s_axis_demux_rx_tlast (nocsdemux_last),
                                           .s_axis_demux_rx_tvalid(nocsdemux_valid),
                                           .s_axis_demux_rx_tready(nocsdemux_ready),

                                           .qsfp_4x_grx_n    (cmac_qsfp_4x_grx_n),
                                           .qsfp_4x_grx_p    (cmac_qsfp_4x_grx_p),
                                           .qsfp_4x_gtx_n    (cmac_qsfp_4x_gtx_n),
                                           .qsfp_4x_gtx_p    (cmac_qsfp_4x_gtx_p),
                                           .qsfp_refck_clk_n (cmac_qsfp_ref_clk_n),
                                           .qsfp_refck_clk_p (cmac_qsfp_ref_clk_p),
<%
    ctrl_tx = 0
    ctrl_rx = 0
    cmac_dest_tofr_offs = 0
    chanid = 2
    loopback_mode = 0

    if (((PITON_FR_Y > PITON_TO_Y) and (PITON_FRY_PORT == 0) and (PITON_TOY_PORT == 0)) or
        ((PITON_FR_X > PITON_TO_X) and (PITON_FRX_PORT == 0) and (PITON_TOX_PORT == 0))):
      loopback_mode = 2

    # Vertical partitioning through CMAC
    if (PITON_FR_Y != 0) and (PITON_FRY_PORT == 0):
      ctrl_rx = 1
      cmac_dest_tofr_offs = PITON_X_TILES*3*2
      for k in [1,2,3]:
        for i in range(PITON_X_TILES):
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_vert_far_eth%d_data),    " % (chanid,PITON_FR_Y-1,i,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_vert_far_eth%d_valid),   " % (chanid,PITON_FR_Y-1,i,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_vert_far_eth%d_ready),   " % (chanid,PITON_FR_Y-1,i,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_vert_far_eth%d_last),    " % (chanid,PITON_FR_Y-1,i,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid + PITON_X_TILES*3*2))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_vert_near_N_eth%d_data), " % (chanid,PITON_FR_Y,i,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_vert_near_N_eth%d_valid)," % (chanid,PITON_FR_Y,i,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_vert_near_N_eth%d_ready)," % (chanid,PITON_FR_Y,i,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_vert_near_N_eth%d_last), " % (chanid,PITON_FR_Y,i,k))
          chanid = chanid + 1
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_vert_near_N_ack%d_data), " % (chanid,PITON_FR_Y,i,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_vert_near_N_ack%d_valid)," % (chanid,PITON_FR_Y,i,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_vert_near_N_ack%d_ready)," % (chanid,PITON_FR_Y,i,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_vert_near_N_ack%d_last), " % (chanid,PITON_FR_Y,i,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid + PITON_X_TILES*3*2))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_vert_far_ack%d_data),    " % (chanid,PITON_FR_Y-1,i,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_vert_far_ack%d_valid),   " % (chanid,PITON_FR_Y-1,i,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_vert_far_ack%d_ready),   " % (chanid,PITON_FR_Y-1,i,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_vert_far_ack%d_last),    " % (chanid,PITON_FR_Y-1,i,k))
          chanid = chanid + 1
    if (PITON_TO_Y != PITON_Y_TILES-1) and (PITON_TOY_PORT == 0):
      ctrl_tx = 1
      for k in [1,2,3]:
        for i in range(PITON_X_TILES):
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_vert_far_eth%d_data),    " % (chanid,PITON_TO_Y+1,i,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_vert_far_eth%d_valid),   " % (chanid,PITON_TO_Y+1,i,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_vert_far_eth%d_ready),   " % (chanid,PITON_TO_Y+1,i,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_vert_far_eth%d_last),    " % (chanid,PITON_TO_Y+1,i,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid - cmac_dest_tofr_offs))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_vert_near_S_eth%d_data), " % (chanid,PITON_TO_Y,i,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_vert_near_S_eth%d_valid)," % (chanid,PITON_TO_Y,i,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_vert_near_S_eth%d_ready)," % (chanid,PITON_TO_Y,i,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_vert_near_S_eth%d_last), " % (chanid,PITON_TO_Y,i,k))
          chanid = chanid + 1
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_vert_near_S_ack%d_data), " % (chanid,PITON_TO_Y,i,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_vert_near_S_ack%d_valid)," % (chanid,PITON_TO_Y,i,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_vert_near_S_ack%d_ready)," % (chanid,PITON_TO_Y,i,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_vert_near_S_ack%d_last), " % (chanid,PITON_TO_Y,i,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid - cmac_dest_tofr_offs))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_vert_far_ack%d_data),    " % (chanid,PITON_TO_Y+1,i,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_vert_far_ack%d_valid),   " % (chanid,PITON_TO_Y+1,i,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_vert_far_ack%d_ready),   " % (chanid,PITON_TO_Y+1,i,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_vert_far_ack%d_last),    " % (chanid,PITON_TO_Y+1,i,k))
          chanid = chanid + 1

    # Horizontal partitioning through CMAC
    if (PITON_FR_X != 0) and (PITON_FRX_PORT == 0):
      ctrl_rx = 1
      cmac_dest_tofr_offs = PITON_Y_TILES*3*2
      for k in [1,2,3]:
        for j in range(PITON_Y_TILES):
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_horz_far_eth%d_data),    " % (chanid,j,PITON_FR_X-1,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_horz_far_eth%d_valid),   " % (chanid,j,PITON_FR_X-1,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_horz_far_eth%d_ready),   " % (chanid,j,PITON_FR_X-1,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_horz_far_eth%d_last),    " % (chanid,j,PITON_FR_X-1,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid + PITON_Y_TILES*3*2))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_horz_near_W_eth%d_data), " % (chanid,j,PITON_FR_X,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_horz_near_W_eth%d_valid)," % (chanid,j,PITON_FR_X,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_horz_near_W_eth%d_ready)," % (chanid,j,PITON_FR_X,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_horz_near_W_eth%d_last), " % (chanid,j,PITON_FR_X,k))
          chanid = chanid + 1
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_horz_near_W_ack%d_data), " % (chanid,j,PITON_FR_X,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_horz_near_W_ack%d_valid)," % (chanid,j,PITON_FR_X,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_horz_near_W_ack%d_ready)," % (chanid,j,PITON_FR_X,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_horz_near_W_ack%d_last), " % (chanid,j,PITON_FR_X,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid + PITON_Y_TILES*3*2))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_horz_far_ack%d_data),    " % (chanid,j,PITON_FR_X-1,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_horz_far_ack%d_valid),   " % (chanid,j,PITON_FR_X-1,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_horz_far_ack%d_ready),   " % (chanid,j,PITON_FR_X-1,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_horz_far_ack%d_last),    " % (chanid,j,PITON_FR_X-1,k))
          chanid = chanid + 1
    if (PITON_TO_X != PITON_X_TILES-1) and (PITON_TOX_PORT == 0):
      ctrl_tx = 1
      for k in [1,2,3]:
        for j in range(PITON_Y_TILES):
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_horz_far_eth%d_data),    " % (chanid,j,PITON_TO_X+1,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_horz_far_eth%d_valid),   " % (chanid,j,PITON_TO_X+1,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_horz_far_eth%d_ready),   " % (chanid,j,PITON_TO_X+1,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_horz_far_eth%d_last),    " % (chanid,j,PITON_TO_X+1,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid - cmac_dest_tofr_offs))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_horz_near_E_eth%d_data), " % (chanid,j,PITON_TO_X,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_horz_near_E_eth%d_valid)," % (chanid,j,PITON_TO_X,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_horz_near_E_eth%d_ready)," % (chanid,j,PITON_TO_X,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_horz_near_E_eth%d_last), " % (chanid,j,PITON_TO_X,k))
          chanid = chanid + 1
          print("      .s_axis_%d_tdata (tile_%d_%d_valrdy_horz_near_E_ack%d_data), " % (chanid,j,PITON_TO_X,k))
          print("      .s_axis_%d_tvalid(tile_%d_%d_valrdy_horz_near_E_ack%d_valid)," % (chanid,j,PITON_TO_X,k))
          print("      .s_axis_%d_tready(tile_%d_%d_valrdy_horz_near_E_ack%d_ready)," % (chanid,j,PITON_TO_X,k))
          print("      .s_axis_%d_tlast (tile_%d_%d_valrdy_horz_near_E_ack%d_last), " % (chanid,j,PITON_TO_X,k))
          print("      .chan_tdest_%d (%d),                                         " % (chanid,chanid - cmac_dest_tofr_offs))
          print("      .m_axis_%d_tdata (tile_%d_%d_valrdy_horz_far_ack%d_data),    " % (chanid,j,PITON_TO_X+1,k))
          print("      .m_axis_%d_tvalid(tile_%d_%d_valrdy_horz_far_ack%d_valid),   " % (chanid,j,PITON_TO_X+1,k))
          print("      .m_axis_%d_tready(tile_%d_%d_valrdy_horz_far_ack%d_ready),   " % (chanid,j,PITON_TO_X+1,k))
          print("      .m_axis_%d_tlast (tile_%d_%d_valrdy_horz_far_ack%d_last),    " % (chanid,j,PITON_TO_X+1,k))
          chanid = chanid + 1

    print("      .loopback_mode(loopback_cmac));")
    print("assign loopback_cmac = 3'h%x;" % (loopback_mode))
    print("assign ctrl_tx_cmac = 1'b%d;" % (ctrl_tx))
    print("assign ctrl_rx_cmac = 1'b%d;" % (ctrl_rx))
%>
   `else                                             
     assign sys_rstn_cmac = 1;
     assign loopback_cmac = 0;
   `endif //`ifdef PITON_MULTI_FPGA_CMAC

`else
    assign {irq_tile, timer_irq_tile, ipi_tile} = {irq_i, timer_irq_i, ipi_i};
    assign rstn_tile                            = rst_n_inter_sync;
`endif //`ifdef PITON_MULTI_FPGA

endmodule

`endif
